# Bot Server Configuration
NODE_ENV=development
BOT_PORT=3001
BOT_NAME=MozosubzBot

# Database Configuration (Render PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/mozosubz_bot
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mozosubz_bot
DB_USER=postgres
DB_PASSWORD=password

# Open Router AI Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=poolside/laguna-m.1:free

# Mozosubz API Configuration
MOZOSUBZ_API_BASE=https://api.mozosubz.xyz
MOZOSUBZ_API_TIMEOUT=30000

# WhatsApp Session Storage
WHATSAPP_SESSION_PATH=./whatsapp-sessions
WHATSAPP_SESSION_NAME=mozosubz-bot

# Logging & Monitoring
LOG_LEVEL=info
ENABLE_AUDIT_LOG=true
